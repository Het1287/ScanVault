<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_scan"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_quick_scan_short"
        android:shortcutLongLabel="@string/shortcut_quick_scan_long">
        <intent
            android:action="com.example.ownscan.ACTION_QUICK_SCAN"
            android:targetPackage="com.example.ownscan"
            android:targetClass="com.example.ownscan.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="view_recents"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_recents_short"
        android:shortcutLongLabel="@string/shortcut_recents_long">
        <intent
            android:action="com.example.ownscan.ACTION_VIEW_RECENTS"
            android:targetPackage="com.example.ownscan"
            android:targetClass="com.example.ownscan.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="import_file"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_import_short"
        android:shortcutLongLabel="@string/shortcut_import_long">
        <intent
            android:action="com.example.ownscan.ACTION_IMPORT_FILE"
            android:targetPackage="com.example.ownscan"
            android:targetClass="com.example.ownscan.MainActivity" />
    </shortcut>
</shortcuts>
